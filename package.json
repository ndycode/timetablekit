{
  "name": "timetablekit-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first timetable parser and calendar export toolkit.",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/lint.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "pnpm --filter @ndycode/timetablekit test:coverage",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "fixture:new": "node scripts/new-fixture.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "security:check": "node scripts/check-secrets.mjs",
    "fixtures:validate": "node scripts/validate-fixtures.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "dependencies:check": "pnpm audit --audit-level=high && pnpm licenses list",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:coverage && pnpm fixtures:validate && pnpm build && pnpm e2e && pnpm validate:links && pnpm security:check && pnpm dependencies:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.9.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.2",
    "sharp": "^0.35.4",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
