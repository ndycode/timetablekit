{
  "name": "@ndycode/timetablekit-agent",
  "version": "0.1.0",
  "description": "Framework-neutral agent tool contract for TimetableKit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ndycode/timetablekit.git"
  },
  "homepage": "https://timetablekit.vercel.app/",
  "bugs": {
    "url": "https://github.com/ndycode/timetablekit/issues"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
