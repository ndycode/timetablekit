{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timetablekit.vercel.app/schema/timetable-result.schema.json",
  "title": "TimetableParseResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "timezone",
    "locale",
    "events",
    "warnings",
    "conflicts",
    "parse"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "source": { "$ref": "#/$defs/source" },
    "timezone": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 1 },
    "term": { "$ref": "#/$defs/term" },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
    "parse": { "$ref": "#/$defs/parse" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["text", "csv", "image", "pdf"] },
        "filename": { "type": "string" },
        "mimeType": { "type": "string" },
        "pageCount": { "type": "integer", "minimum": 0 }
      }
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "time": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startsOn", "endsOn"],
      "properties": {
        "startsOn": { "$ref": "#/$defs/date" },
        "endsOn": { "$ref": "#/$defs/date" }
      }
    },
    "weekday": { "enum": ["MO", "TU", "WE", "TH", "FR", "SA", "SU"] },
    "eventField": {
      "enum": [
        "title",
        "code",
        "eventType",
        "schedule",
        "startTime",
        "endTime",
        "timezone",
        "location",
        "instructor",
        "notes"
      ]
    },
    "warningCode": {
      "enum": [
        "UNSUPPORTED_FILE_TYPE",
        "UNRECOGNIZED_CSV",
        "FILE_TOO_LARGE",
        "TOO_MANY_PAGES",
        "NO_TEXT_FOUND",
        "NO_EVENTS_FOUND",
        "LOW_CONFIDENCE",
        "UNKNOWN_DAY_LABEL",
        "UNKNOWN_LOCALE",
        "AMBIGUOUS_TIME",
        "MISSING_TITLE",
        "MISSING_START_TIME",
        "MISSING_END_TIME",
        "INVALID_TIME_RANGE",
        "INVALID_DATE",
        "INVALID_TERM_RANGE",
        "INVALID_TIMEZONE",
        "DUPLICATE_EVENT",
        "POSSIBLE_DUPLICATE",
        "SCHEDULE_CONFLICT",
        "CONFLICT_LIMIT",
        "OUTSIDE_TERM_RANGE",
        "OCR_PARTIAL",
        "UNSUPPORTED_PROVIDER",
        "PROVIDER_FAILED",
        "PROVIDER_ABORTED",
        "PROVIDER_TIMEOUT",
        "PROVIDER_OUTPUT_INVALID",
        "AI_PROVIDER_UNAVAILABLE",
        "AI_RECOVERY_SKIPPED",
        "AI_OUTPUT_INVALID"
      ]
    },
    "schedule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "weekdays"],
          "properties": {
            "kind": { "const": "weekly" },
            "weekdays": {
              "type": "array",
              "items": { "$ref": "#/$defs/weekday" },
              "minItems": 1
            },
            "startsOn": { "$ref": "#/$defs/date" },
            "endsOn": { "$ref": "#/$defs/date" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "exactDates"],
          "properties": {
            "kind": { "const": "exact" },
            "exactDates": {
              "type": "array",
              "items": { "$ref": "#/$defs/date" },
              "minItems": 1
            }
          }
        }
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "charStart": { "type": "integer", "minimum": 0 },
        "charEnd": { "type": "integer", "minimum": 0 },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "location"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "location": { "$ref": "#/$defs/location" },
        "excerpt": { "type": "string" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "schedule",
        "startTime",
        "endTime",
        "timezone",
        "confidence",
        "fieldConfidence",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "code": { "type": "string" },
        "eventType": { "type": "string" },
        "schedule": { "$ref": "#/$defs/schedule" },
        "startTime": { "$ref": "#/$defs/time" },
        "endTime": { "$ref": "#/$defs/time" },
        "timezone": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "instructor": { "type": "string" },
        "notes": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "fieldConfidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": "number", "minimum": 0, "maximum": 1 },
            "code": { "type": "number", "minimum": 0, "maximum": 1 },
            "eventType": { "type": "number", "minimum": 0, "maximum": 1 },
            "schedule": { "type": "number", "minimum": 0, "maximum": 1 },
            "startTime": { "type": "number", "minimum": 0, "maximum": 1 },
            "endTime": { "type": "number", "minimum": 0, "maximum": 1 },
            "timezone": { "type": "number", "minimum": 0, "maximum": 1 },
            "location": { "type": "number", "minimum": 0, "maximum": 1 },
            "instructor": { "type": "number", "minimum": 0, "maximum": 1 },
            "notes": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "array",
              "items": { "$ref": "#/$defs/evidence" }
            },
            "code": {
              "type": "array",
              "items": { "$ref": "#/$defs/evidence" }
            },
            "eventType": {
              "type": "array",
              "items": { "$ref": "#/$defs/evidence" }
            },
            "schedule": {
              "type": "array",
              "items": { "$ref": "#/$defs/evidence" }
            },
            "startTime": {
              "type": "array",
              "items": { "$ref": "#/$defs/evidence" }
            },
            "endTime": {
              "type": "array",
              "items": { "$ref": "#/$defs/evidence" }
            },
            "timezone": {
              "type": "array",
              "items": { "$ref": "#/$defs/evidence" }
            },
            "location": {
              "type": "array",
              "items": { "$ref": "#/$defs/evidence" }
            },
            "instructor": {
              "type": "array",
              "items": { "$ref": "#/$defs/evidence" }
            },
            "notes": {
              "type": "array",
              "items": { "$ref": "#/$defs/evidence" }
            }
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/warningCode" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "eventId": { "type": "string", "minLength": 1 },
        "field": { "$ref": "#/$defs/eventField" },
        "source": { "$ref": "#/$defs/location" },
        "details": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "id", "eventIds", "occurrence", "overlap"],
      "properties": {
        "code": { "const": "SCHEDULE_CONFLICT" },
        "id": { "type": "string", "minLength": 1 },
        "eventIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "occurrence": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "weekday"],
              "properties": {
                "kind": { "const": "weekday" },
                "weekday": { "$ref": "#/$defs/weekday" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "date"],
              "properties": {
                "kind": { "const": "date" },
                "date": { "$ref": "#/$defs/date" }
              }
            }
          ]
        },
        "overlap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startsAt", "endsAt"],
          "properties": {
            "startsAt": { "$ref": "#/$defs/time" },
            "endsAt": { "$ref": "#/$defs/time" }
          }
        }
      }
    },
    "stageReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "status", "durationMs", "warningCount"],
      "properties": {
        "stage": {
          "enum": [
            "preflight",
            "extract",
            "normalize",
            "segment",
            "recognize",
            "assemble",
            "locale",
            "deduplicate",
            "validate",
            "conflicts",
            "confidence",
            "recovery",
            "finalize"
          ]
        },
        "status": { "enum": ["completed", "skipped", "failed"] },
        "durationMs": { "type": "number", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "providerId": { "type": "string", "minLength": 1 }
      }
    },
    "parse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationMs",
        "deterministicConfidence",
        "aiRecoveryUsed",
        "providersUsed",
        "stageReports"
      ],
      "properties": {
        "durationMs": { "type": "number", "minimum": 0 },
        "deterministicConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "aiRecoveryUsed": { "type": "boolean" },
        "providersUsed": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "stageReports": {
          "type": "array",
          "items": { "$ref": "#/$defs/stageReport" }
        }
      }
    }
  }
}
