{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next",
      "config": {
        "installCommand": "corepack pnpm install --frozen-lockfile",
        "buildCommand": "corepack pnpm --filter web build"
      }
    }
  ]
}
